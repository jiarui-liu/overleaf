extends ../layout-website-redesign

block vars
	- isWebsiteRedesign = true
	//- Paper Mentor runs on Overleaf CE but is a separate service with its own
	//- accounts. The stock navbar/footer read as overleaf.com, so the login page
	//- draws its own chrome and says plainly that overleaf.com logins won't work.
	- suppressNavbar = true
	- suppressFooter = true
	- var hasAdminContact = settings.adminEmail && settings.adminEmail !== 'placeholder@example.com'

block content
	main#main-content.pm-login
		.pm-login-card
			section.pm-login-brand(aria-hidden='true')
				.pm-login-mark PM
				p.pm-login-wordmark Paper Mentor
				p.pm-login-tagline
					| AI feedback on your LaTeX papers, from a University of Toronto research team.

			section.pm-login-panel
				h1.pm-login-title
					if login_support_title
						| !{login_support_title}
					else
						| Sign in to Paper Mentor

				.pm-login-notice(role='note')
					strong Not overleaf.com.
					|
					| Your Overleaf account won't work here. Sign in with the email and password the Paper Mentor team set up for you.

				form(name='loginForm' data-ol-async-form action='/login' method='POST')
					input(name='_csrf' type='hidden' value=csrfToken)
					+formMessagesNewStyle
					+customFormMessageNewStyle('invalid-password-retry-or-reset', 'danger')
						| !{translate('email_or_password_wrong_try_again_or_reset', {}, [{ name: 'a', attrs: { href: '/user/password/reset', 'aria-describedby': 'resetPasswordDescription' } }])}
						span.visually-hidden(id='resetPasswordDescription')
							| #{translate('reset_password_link')}
					+customFormMessageNewStyle('password-compromised')
						| !{translate('password_compromised_try_again_or_use_known_device_or_reset', {}, [{name: 'a', attrs: {href: 'https://haveibeenpwned.com/passwords', rel: 'noopener noreferrer', target: '_blank'}}, {name: 'a', attrs: {href: '/user/password/reset', target: '_blank'}}])}.
					.form-group
						label(for='email') Paper Mentor email
						input#email.form-control(
							name='email'
							type='email'
							required
							autofocus='true'
							autocomplete='username'
						)
					.form-group
						label(for='password') #{translate("password")}
						input#password.form-control(
							name='password'
							type='password'
							autocomplete='current-password'
							required
						)
					button.btn.pm-login-submit(type='submit' data-ol-disabled-inflight)
						span(data-ol-inflight='idle') Sign in
						span(hidden data-ol-inflight='pending') #{translate("logging_in")}…
					.pm-login-links
						a(href='/user/password/reset') #{translate("forgot_your_password")}?
						if hasAdminContact
							a(href='mailto:' + settings.adminEmail) Need an account?

				if login_support_text
					p.pm-login-support !{login_support_text}

		p.pm-login-footnote
			| Paper Mentor is built on the open-source
			|
			a(href='https://github.com/overleaf/overleaf' rel='noopener noreferrer' target='_blank') Overleaf Community Edition
			| . It is not operated by or affiliated with Overleaf.
